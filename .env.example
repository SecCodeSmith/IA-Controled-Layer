# AI Control Layer Environment Configuration
# Copy to .env and adjust for your environment

# Model Provider Selection
CTRL_MODEL_PROVIDER=auto                                    # auto | mock | openai_compatible

# Ollama Configuration
# CTRL_OLLAMA_BASE_URL is for native runs; docker-compose.yml reads DOCKER_OLLAMA_BASE_URL instead:
#   - Native run (Windows/Linux/macOS):     http://localhost:11434
#   - Docker Desktop (Windows/macOS):       http://host.docker.internal:11434
#   - Docker Engine in WSL2 (NAT mode):     http://<windows-host-ip>:11434
#     Get Windows IP inside WSL: ip route show default | awk '{print $3}'
#     IMPORTANT: On Windows, set Ollama to listen on all interfaces first:
#       1. Set env var: OLLAMA_HOST=0.0.0.0:11434
#       2. Restart Ollama from the tray
#       3. Verify: netstat -ano | findstr 11434 (should show 0.0.0.0:11434)
#       4. Allow firewall: netsh advfirewall firewall add rule name="Ollama 11434" \
#          dir=in action=allow protocol=TCP localport=11434
CTRL_OLLAMA_BASE_URL=http://localhost:11434                # Ollama endpoint for native runs (run_dev.ps1)
# Used only by docker-compose.yml (containers cannot reach the host's localhost).
# Docker Desktop: host.docker.internal. Docker Engine inside WSL2: use the Windows host IP seen
# from WSL (e.g. http://172.24.192.1:11434; find it with `ip route | grep default` in WSL)
# and start Ollama with OLLAMA_HOST=0.0.0.0:11434.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
CTRL_OLLAMA_MODEL=qwen2.5:7b                               # Model name for agent
CTRL_JUDGE_MODEL=qwen2.5:7b                                # Model name for LLM judge

# OpenAI-Compatible Provider (if used)
CTRL_OPENAI_BASE_URL=                                      # OpenAI-compatible endpoint
CTRL_OPENAI_API_KEY=                                       # API key for OpenAI-compatible

# Redis Cache
CTRL_REDIS_URL=redis://localhost:6379/0                    # Redis connection URL (auto-fallback to memory)

# Configuration Files
CTRL_POLICY_FILE=config/policy.yaml                         # Policy document (hot-reloaded)
CTRL_MCP_SERVERS_FILE=config/mcp_servers.yaml              # MCP server definitions
CTRL_SIGNATURES_FILE=config/attack_signatures.yaml          # Attack signature feed (local)
CTRL_SIGNATURE_FEED_URL=                                    # Optional HTTP feed for signatures (P1)
CTRL_USERS_FILE=config/users.yaml                           # Mock SSO users

# Output Files
CTRL_ALERTS_XLSX=alerts/alerts.xlsx                         # Excel alerts sink
CTRL_AUDIT_JSONL=audit/calls.jsonl                          # Audit log (JSONL)

# ML Classifier
CTRL_ML_MODEL_PATH=src/control_layer/ml/artifacts/prompt_injection_classifier.joblib
CTRL_ML_TREE_PATH=src/control_layer/ml/artifacts/prompt_injection_tree.joblib
CTRL_ML_TREE_SUPPLEMENT_PATH=src/control_layer/ml/dataset/benign_operational.csv
CTRL_TRAINING_SAMPLES_PATH=data/judge_samples.jsonl
CTRL_VERIFY_SAMPLE_SALT=dev-salt
CTRL_RETRAIN_MIN_F1=0.85

# Security
CTRL_JWT_SECRET=dev-secret-change-me                        # HS256 JWT signing key (CHANGE in production)
CTRL_ADMIN_TOKEN=admin-dev-token                            # Admin API token

# CORS
CTRL_CORS_ORIGINS=http://localhost:5173                     # Comma-separated origins for CORS

# Control Layer Port
CTRL_PORT=8080                                              # Control layer API port
CTRL_GATEWAY_DEFAULT_USER=anna.kowalska                      # User for clients without credentials (Ollama/Copilot); empty disables

# Demo Agent Configuration
AGENT_CONTROL_LAYER_URL=http://localhost:8080              # Demo agent -> control layer
AGENT_PORT=8090                                             # Demo agent port

# Frontend Configuration
VITE_CONTROL_LAYER_URL=http://localhost:8080               # Frontend -> control layer API
VITE_AGENT_URL=http://localhost:8090                        # Frontend -> demo agent
VITE_ADMIN_TOKEN=admin-dev-token                            # Frontend admin token

# Python UTF-8 (set by scripts, but can be overridden)
# PYTHONUTF8=1
# PYTHONIOENCODING=utf-8
